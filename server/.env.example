NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/GramRosh
# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Cloudinary (images are uploaded/stored as WebP)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=organic-store

# Hardcoded mobile-banking merchant numbers shown at checkout
BKASH_NUMBER=01XXXXXXXXX
NAGAD_NUMBER=01XXXXXXXXX
ROCKET_NUMBER=01XXXXXXXXXX

# Shown on invoices + support widget
BRAND_NAME=Gram Rosh
BRAND_ADDRESS=123 Main Street, City, Country
SUPPORT_PHONE=+1234567890
SUPPORT_WHATSAPP=+1234567890

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!12345
